{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=investir_db;Username=admin;Password=admin"
  },
  "Security": {
    "AppUrl": "http://localhost:5173",
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ],
    "EnforceHttps": false,
    "Jwt": {
      "Issuer": "InvestirGo",
      "Audience": "InvestirGoClient",
      "SecretKey": "InvestirGo_DevSecretKey_AtLeast32Bytes_ChangeInProduction2026!",
      "AccessTokenLifetimeMinutes": 10
    },
    "Session": {
      "AbsoluteLifetimeDays": 7,
      "InactivityLifetimeHours": 24,
      "GraceWindowSeconds": 20,
      "CookieName": "__Host-investir_refresh",
      "FallbackCookieName": "investir_refresh"
    },
    "Argon2": {
      "MemorySizeKb": 65536,
      "Iterations": 3,
      "DegreeOfParallelism": 4,
      "SaltSizeBytes": 16,
      "HashSizeBytes": 32
    },
    "Totp": {
      "Issuer": "InvestirGo",
      "EncryptionKeyBase64": "qZ3jN8wK1sL0vP9xT2yU5aB7cE4fH6mI8jK9oL1pQ3s=",
      "StepSeconds": 30,
      "TotpSize": 6,
      "RecoveryCodesCount": 8
    },
    "RateLimit": {
      "LoginMaxAttempts": 5,
      "LoginWindowMinutes": 15,
      "RegisterMaxAttempts": 3,
      "RegisterWindowHours": 1,
      "ResetMaxAttempts": 3,
      "ResetWindowHours": 1,
      "RefreshMaxAttemptsPerMinute": 30,
      "MfaMaxAttempts": 5,
      "MfaWindowMinutes": 5
    }
  },
  "AllowedHosts": "*"
}
