# ============================================================================
# InvestirGo - Exemplo de Variáveis de Ambiente (.env.example)
# NUNCA comite arquivos .env reais contendo segredos de produção no repositório.
# ============================================================================

# Banco de Dados PostgreSQL
POSTGRES_DB=investir_db
POSTGRES_USER=investir_app
POSTGRES_PASSWORD=alterar_para_senha_forte_em_producao
POSTGRES_PORT=5432
CONNECTION_STRING=Host=postgres;Port=5432;Database=investir_db;Username=investir_app;Password=alterar_para_senha_forte_em_producao

# EasyPanel/Hostinger: copie a opção "Internal Connection URL" do PostgreSQL.
# Caracteres especiais da senha devem permanecer codificados como aparecem na URL.
DATABASE_URL=postgresql://investir_app:senha_codificada@investir-go_db:5432/investir-go

# Cotação e histórico de mercado (https://brapi.dev)
BRAPI_KEY=adicione_a_chave_da_brapi

# Configurações de Segurança e Criptografia
# Chave JWT: Mínimo de 32 bytes (256 bits). Pode ser gerada via: openssl rand -base64 32
SECURITY__JWT__SECRETKEY=alterar_obrigatoriamente_para_chave_secreta_de_32_bytes_ou_mais
SECURITY__JWT__ISSUER=InvestirGo
SECURITY__JWT__AUDIENCE=InvestirGoClient
SECURITY__JWT__ACCESSTOKENLIFETIMEMINUTES=10

# Chave de Cifragem TOTP AES-256-GCM (32 bytes em Base64)
# Gere com: openssl rand -base64 32
SECURITY__TOTP__ENCRYPTIONKEYBASE64=alterar_para_chave_base64_de_32_bytes_gerada_aleatoriamente

# URLs e CORS
SECURITY__APPURL=https://investirgo.com
SECURITY__ALLOWEDORIGINS__0=https://investirgo.com
SECURITY__ALLOWEDORIGINS__1=https://app.investirgo.com
SECURITY__ENFORCEHTTPS=true

# Sessão e Cookies
SECURITY__SESSION__ABSOLUTELIFETIMEDAYS=7
SECURITY__SESSION__INACTIVITYLIFETIMEHOURS=24
SECURITY__SESSION__GRACEWINDOWSECONDS=20
SECURITY__SESSION__COOKIENAME=__Host-investir_refresh
